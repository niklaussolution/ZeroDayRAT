# Secrets — never commit these
backend/.env
backend/firebase-service-account.json
android-app/app/google-services.json
android-app/local.properties

# Node
**/node_modules/
backend/server.log
dashboard/dashboard_dev.log

# Android build output
android-app/.gradle/
android-app/app/build/
android-app/build/
android-app/*.iml
android-app/.idea/
android-app/local.properties
android-app/captures/
android-app/.cxx/

# Dashboard build output
dashboard/dist/
dashboard/dist-ssr/

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
__pycache__/
*.py[cod]

# Scratch/test files
scratch/
*.png

# Local tooling / agent execution records (terminal transcripts + captured
# command output). Runtime scratch only - never part of the project.
.hackerai/
*.orig
*.rej

# Target APKs & binary packages
dashboard/src/targetApk/
backend/build_workspace/
*.apk
*.aab
*.zip
.gradle/
tools/

# Signing material - a leaked keystore lets anyone ship updates as this app
*.jks
*.keystore
*.p12
!debug.keystore
signing.properties

# Build artifacts the backend serves from disk. They must never be committed:
# the APK is ~8 MB and changes on every build, so keeping it in git bloats the
# history permanently. GET /api/download/apk streams it from here instead.
backend/storage/

# Legacy static location - kept ignored so an old build output cannot creep
# back into the repository if someone runs an older checkout.
dashboard/public/download/*.apk
dashboard/public/download/*.json


